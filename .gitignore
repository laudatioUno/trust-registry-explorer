# History-Feature: die SQLite-Datenbank und ihre WAL/SHM-Begleitdateien
# sind Laufzeitdaten (vom Cronjob collect.php erzeugt) und gehören nicht
# ins Repository. storage/.gitkeep sorgt dafür, dass der Ordner selbst
# trotzdem mitversioniert wird.
storage/*.sqlite
storage/*.sqlite-wal
storage/*.sqlite-shm
storage/collect.log

# Preview-Marker: leere Datei, wird pro Server von Hand angelegt
# (touch storage/.preview). Nicht versionieren, damit PROD nie
# versehentlich als Preview erscheint.
storage/.preview

# Lokale, installationsspezifische Konfiguration (z.B. zusätzliche
# Umgebungen); siehe README "Local configuration".
storage/config.local.php
